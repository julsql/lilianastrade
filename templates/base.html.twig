<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% set base_url = site_url|trim('/', 'right') %}
        {% set canonical_url = base_url ~ app.request.pathInfo %}
        {% set og_image = base_url ~ '/images/deco/Liliana%20full.jpg' %}
        <title>{% block head_title %}{% block title %}Liliana's Trade{% endblock %} | Liliana's Trade{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}Liliana's Trade, marché Magic: The Gathering : consultez les decks publiés par les marchands et gérez votre collection de cartes en ligne.{% endblock %}">
        <link rel="canonical" href="{{ canonical_url }}">
        <meta name="theme-color" content="#130922">

        <meta property="og:type" content="{% block og_type %}website{% endblock %}">
        <meta property="og:site_name" content="Liliana's Trade">
        <meta property="og:locale" content="fr_FR">
        <meta property="og:title" content="{{ block('head_title') }}">
        <meta property="og:description" content="{{ block('meta_description') }}">
        <meta property="og:url" content="{{ canonical_url }}">
        <meta property="og:image" content="{{ og_image }}">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="675">
        <meta property="og:image:alt" content="Illustration de Liliana, Liliana's Trade">
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ block('head_title') }}">
        <meta name="twitter:description" content="{{ block('meta_description') }}">
        <meta name="twitter:image" content="{{ og_image }}">

        <link rel="icon" href="{{ asset('assets/favicon.ico') }}" sizes="any">
        <link rel="icon" type="image/jpeg" href="/images/deco/icon.jpg">
        <link rel="apple-touch-icon" href="/images/deco/icon.jpg">
        <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>

        <script defer src="https://stats.julsql.fr/js/app.js" data-website-id="ee3bf4a2-f93e-4613-b0ac-502ea671034f" data-domains="lilianastrade.julsql.fr"></script>

        {% block json_ld %}{% endblock %}

        {{ include('style.html.twig') }}
        {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
        {% block stylesheets %}

            <!-- Core theme CSS (includes Bootstrap)-->
            <link href="{{ asset('css/styles.css') }}" rel="stylesheet">
        {% endblock %} {# stylesheets #}
    </head>
    <body>

    {% block menu %}
        <!-- Navigation -->

        <nav class="navbar navbar-expand-lg">

            <div class="container">
                <a class="navbar-brand" href="{{ path('app_home') }}"><img src="{{ path('app_home') }}images/deco/home.svg" alt="Accueil Liliana's Trade" width="50" height="50"></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        {{ include('menu.html.twig', { menu: 'main' }) }}
                        {% if app.user %}
                            {{ include('menu.html.twig', { menu: 'account' }) }}
                        {% else %}
                            {{ include('menu.html.twig', { menu: 'anonymousaccount' }) }}
                        {% endif %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <a class="navbar-brand" href="{{ path('admin') }}"><img src="{{ path('app_home') }}images/deco/settings.svg" alt="Administration" width="20" height="20" style="margin-left:20px;"></a>
                        {% endif %}
                    </ul>
                </div>
            </div>

        </nav>
    {% endblock %}{# menu #}

    {% block body %}


        <div class="container body-container">

            {% block alerts %}
                {% for type, messages in app.session.flashBag.all %}
                    {% for message in messages %}
                        {%if type == 'error'%} {% set type = 'danger' %} {%endif%}
                        {%if type == 'message'%} {% set type = 'info' %} {%endif%}
                        {# Bootstrap alert, see http://getbootstrap.com/components/#alerts #}
                        <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                            <button type="button" class="close" data-bs-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                                <span class="sr-only">Close</span>
                            </button>
                            <p>{{ message|raw }}</p>
                        </div>
                    {% endfor %}
                {% endfor %}
            {% endblock %} {# alerts #}

            <main>

                {# Ici la partie utile que les gabarits des pages vont surcharger #}
                {% block main %}
                    <div class="row">
                        <div class="col-md-12">
                            <p>
                                <i>MAIN</i>
                            </p>
                        </div>
                    </div>
                {% endblock %} {# main #}

            </main>

        </div> <!-- /.body-container -->

        {% block footer %}
            <footer class="text-center text-lg-start bg-light text-muted">
                <div class="text-center p-4" style="background-color: rgba(0, 0, 0, 0.05);">
                    Application développée par Jul SQL dans le cadre d'un projet informatique sur PHP de deuxième année d'école d'ingénieur.
                </div>
            </footer>
        {% endblock %}{# footer #}

    {% block javascripts %}
        <!-- Bootstrap core JS-->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <!-- Core theme JS-->
        <script src="{{ asset('js/scripts.js') }}"></script>
    {% endblock %} {# javascripts #}

    {% endblock %} {# body #}
    </body>
</html>
