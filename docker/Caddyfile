# Based on the default dunglas/frankenphp Caddyfile, plus cache headers for static assets.
{
	skip_install_trust
	{$CADDY_GLOBAL_OPTIONS}
	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	root {$SERVER_ROOT:public/}
	@compressible not path /.well-known/mercure
	encode @compressible zstd br gzip

	@images path /images/* /uploads/* /media/* *.ico *.svg
	header @images Cache-Control "public, max-age=604800"

	@assets path /startbootstrap-shop-homepage-gh-pages/* /bundles/*
	header @assets Cache-Control "public, max-age=86400"

	{$CADDY_SERVER_EXTRA_DIRECTIVES}
	php_server {
	}
}

import Caddyfile.d/*.caddyfile
